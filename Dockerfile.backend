FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

COPY api.py data_loader.py evaluate.py feature_engineering.py main.py model.py vault_bootstrap.py ./
COPY data ./data

RUN mkdir -p outputs \
    && python main.py --data-dir data --output-file outputs/final_output.csv --model-file model.pkl --scaler-file scaler.pkl

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]